{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kagra.dev/schemas/world.json",
  "title": "KAGRA World dump",
  "description": "JSON from World.dump() / World.load(), ingested by kagra-shared Scene3D::from_world_json. Stable string ids, not GPU mesh integers. Python mutates the world. Height fn cannot dump; named demo fn or samples. Single parent id (n-level TRS is later). Renderer switch is the next slice.",
  "type": "object",
  "required": ["version"],
  "properties": {
    "version": { "const": 1 },
    "half": { "type": "number" },
    "floor_y": { "type": "number" },
    "gravity": { "type": "number" },
    "water_y": { "type": ["number", "null"] },
    "coins": { "type": "integer", "minimum": 0 },
    "player": { "$ref": "#/$defs/walker" },
    "props": {
      "type": "array",
      "items": { "$ref": "#/$defs/prop" }
    },
    "walkers": {
      "type": "array",
      "items": { "$ref": "#/$defs/walker" }
    },
    "lights": {
      "type": "array",
      "items": { "$ref": "#/$defs/light" }
    },
    "cameras": {
      "type": "array",
      "items": { "$ref": "#/$defs/camera" }
    },
    "heightfield": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/$defs/heightfield" }
      ]
    }
  },
  "$defs": {
    "vec3": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": { "type": "number" }
    },
    "prop": {
      "type": "object",
      "required": ["id", "type"],
      "properties": {
        "id": { "type": "string", "description": "Stable string id, e.g. prop:1" },
        "type": { "const": "prop" },
        "name": { "type": "string" },
        "position": { "$ref": "#/$defs/vec3" },
        "yaw": { "type": "number" },
        "model": { "type": "string" },
        "gltf": { "type": ["string", "null"] },
        "scale": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": { "type": "number" }
        },
        "enabled": { "type": "boolean" },
        "parent": {
          "type": ["string", "null"],
          "description": "Parent prop id. One level is enough this mountain."
        },
        "color": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": { "type": "integer" }
        }
      }
    },
    "walker": {
      "type": "object",
      "required": ["id", "type"],
      "properties": {
        "id": { "type": "string", "description": "e.g. walker:player" },
        "type": { "const": "walker" },
        "name": { "type": "string" },
        "position": { "$ref": "#/$defs/vec3" },
        "yaw": { "type": "number" },
        "face": { "type": "number" },
        "on_ground": { "type": "boolean" }
      }
    },
    "light": {
      "type": "object",
      "required": ["id", "type"],
      "properties": {
        "id": { "type": "string", "description": "e.g. light:0" },
        "type": { "const": "light" },
        "name": { "type": "string" },
        "position": { "$ref": "#/$defs/vec3" },
        "kind": { "type": "string", "enum": ["point", "spot"] },
        "slot": { "type": "integer", "minimum": 0, "maximum": 3 },
        "intensity": { "type": "number" },
        "radius": { "type": "number" },
        "color": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": { "type": "number" }
        },
        "direction": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/vec3" }
          ]
        }
      }
    },
    "camera": {
      "type": "object",
      "required": ["id", "type"],
      "properties": {
        "id": { "type": "string", "description": "e.g. camera:main" },
        "type": { "const": "camera" },
        "name": { "type": "string" },
        "position": { "$ref": "#/$defs/vec3" },
        "target": { "$ref": "#/$defs/vec3" },
        "fov": { "type": "number" }
      }
    },
    "terrain_tile": {
      "type": "object",
      "required": ["id"],
      "properties": {
        "id": { "type": "string", "description": "e.g. tile:0,0" },
        "type": { "const": "terrain_tile" },
        "name": { "type": "string" },
        "ix": { "type": "integer" },
        "iz": { "type": "integer" },
        "position": { "$ref": "#/$defs/vec3" },
        "loaded": { "type": "boolean" },
        "has_mesh": { "type": "boolean" },
        "albedo_ok": {
          "type": "boolean",
          "description": "False when a leftover loaded tile has missing/1x1 albedo or no mesh while GPU tex is set (bald leftover)."
        }
      }
    },
    "heightfield": {
      "type": "object",
      "properties": {
        "fn": {
          "type": ["string", "null"],
          "description": "Named demo height_fn: island_height / overworld_height / open_world_height. Live Python fn cannot dump."
        },
        "tile": { "type": ["number", "null"] },
        "stream_radius": { "type": ["number", "null"] },
        "cells": { "type": ["integer", "null"] },
        "lod_radius": { "type": ["number", "null"] },
        "lod_cells": { "type": ["integer", "null"] },
        "uv": {
          "type": "object",
          "properties": {
            "half": { "type": ["number", "null"] },
            "period": { "type": ["number", "null"] },
            "blend": { "type": "number" },
            "pad": { "type": "number" },
            "rect": {
              "oneOf": [
                { "type": "null" },
                {
                  "type": "array",
                  "minItems": 4,
                  "maxItems": 4,
                  "items": { "type": "number" }
                }
              ]
            }
          }
        },
        "tiles": {
          "type": "array",
          "items": { "$ref": "#/$defs/terrain_tile" }
        },
        "samples": {
          "type": "array",
          "items": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": { "type": "number" },
            "description": "[x, z, y]"
          }
        }
      }
    }
  }
}
