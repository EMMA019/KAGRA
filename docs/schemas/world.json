{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kagra.dev/schemas/world.json",
  "title": "KAGRA World dump",
  "description": "JSON from World.dump() / World.load(), ingested by kagra-shared WorldDoc (not Scene3D). Scene3D is a one-frame draw list; WorldDoc::compile_scene builds it (heightfield batches from named fn or samples, glTF via gltf_load, sprite/quad XY cards, capsule player, metal coins, lights slot=0..3). WorldPlay ticks title→play→result (WASD, pick up, count, finish). render_world_doc (shared wgpu 30 offscreen) draws that frame to RGBA. python -m kagra.play_world is the official Crest collectathon window. Stable string ids, not GPU mesh integers. Live Python height_fn cannot dump; named demo fn or samples. Single parent id (n-level TRS is later). RendererV2 stays for leftover VRM demos only.",
  "type": "object",
  "required": ["version"],
  "properties": {
    "version": { "const": 1 },
    "half": { "type": "number" },
    "floor_y": { "type": "number" },
    "gravity": { "type": "number" },
    "water_y": { "type": ["number", "null"] },
    "coins": { "type": "integer", "minimum": 0 },
    "player": { "$ref": "#/$defs/walker" },
    "props": {
      "type": "array",
      "items": { "$ref": "#/$defs/prop" }
    },
    "walkers": {
      "type": "array",
      "items": { "$ref": "#/$defs/walker" }
    },
    "lights": {
      "type": "array",
      "items": { "$ref": "#/$defs/light" }
    },
    "cameras": {
      "type": "array",
      "items": { "$ref": "#/$defs/camera" }
    },
    "heightfield": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/$defs/heightfield" }
      ]
    },
    "ibl": {
      "type": ["number", "null"],
      "description": "Diffuse IBL strength. Omit = 0.35 (outdoor). 0 = off. Shared wgpu 30 shader Globals.env.x; not a 4K HDR cubemap."
    },
    "exposure": {
      "type": ["number", "null"],
      "description": "Linear exposure. Omit = 1.0. Globals.env.y."
    },
    "tonemap": {
      "type": ["boolean", "null"],
      "description": "ACES tonemap. Omit = on. Globals.env.w. Reinhard is not used; ACES matches kagra-core V2."
    }
  },
  "$defs": {
    "vec3": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": { "type": "number" }
    },
    "prop": {
      "type": "object",
      "required": ["id", "type"],
      "properties": {
        "id": { "type": "string", "description": "Stable string id, e.g. prop:1" },
        "type": { "const": "prop" },
        "name": { "type": "string" },
        "position": { "$ref": "#/$defs/vec3" },
        "yaw": { "type": "number" },
        "model": {
          "type": "string",
          "description": "box/sphere/capsule/plane/sprite/quad. sprite|quad is a standing XY card in compile_scene (same WorldDoc as 3D). name target = FPS range hitscan (look + fire + hit). name tower + waypoint + creep = TD lane (path walk, tower hit, leak/clear). name finish + split = race drive (steer+throttle, lap/finish). name opponent = fight round (J/click attack, hitstun, KO)."
        },
        "gltf": { "type": ["string", "null"] },
        "scale": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": { "type": "number" }
        },
        "enabled": { "type": "boolean" },
        "parent": {
          "type": ["string", "null"],
          "description": "Parent prop id. One level is enough this mountain."
        },
        "color": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": { "type": "integer" }
        },
        "metallic": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Coins dump 1.0. Shared compile_scene uses Material::Metal."
        },
        "roughness": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Coins dump 0.12 (GGX). Default 1."
        }
      }
    },
    "walker": {
      "type": "object",
      "required": ["id", "type"],
      "properties": {
        "id": { "type": "string", "description": "e.g. walker:player" },
        "type": { "const": "walker" },
        "name": { "type": "string" },
        "position": { "$ref": "#/$defs/vec3" },
        "yaw": { "type": "number" },
        "face": { "type": "number" },
        "on_ground": { "type": "boolean" },
        "model": {
          "type": "string",
          "description": "Same dump key as prop.model. Capsule fallback when no glTF."
        },
        "gltf": {
          "type": ["string", "null"],
          "description": "Same dump key as prop.gltf. Skinned glTF 2.0 / .glb / .vrm (glTF-binary + VRM 0/1 extras). CPU-skinned into Vertex3 on play_world. Capsule if missing."
        },
        "clip": {
          "type": "number",
          "description": "Seconds into the walk clip. 0 = rest / T-pose. Advances while WASD walking."
        }
      }
    },
    "light": {
      "type": "object",
      "required": ["id", "type"],
      "properties": {
        "id": { "type": "string", "description": "e.g. light:0" },
        "type": { "const": "light" },
        "name": { "type": "string" },
        "position": { "$ref": "#/$defs/vec3" },
        "kind": { "type": "string", "enum": ["point", "spot"] },
        "slot": { "type": "integer", "minimum": 0, "maximum": 3 },
        "intensity": { "type": "number" },
        "radius": { "type": "number" },
        "color": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": { "type": "number" }
        },
        "direction": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/vec3" }
          ]
        }
      }
    },
    "camera": {
      "type": "object",
      "required": ["id", "type"],
      "properties": {
        "id": { "type": "string", "description": "e.g. camera:main" },
        "type": { "const": "camera" },
        "name": { "type": "string" },
        "position": { "$ref": "#/$defs/vec3" },
        "target": { "$ref": "#/$defs/vec3" },
        "fov": { "type": "number" }
      }
    },
    "terrain_tile": {
      "type": "object",
      "required": ["id"],
      "properties": {
        "id": { "type": "string", "description": "e.g. tile:0,0" },
        "type": { "const": "terrain_tile" },
        "name": { "type": "string" },
        "ix": { "type": "integer" },
        "iz": { "type": "integer" },
        "position": { "$ref": "#/$defs/vec3" },
        "loaded": { "type": "boolean" },
        "has_mesh": { "type": "boolean" },
        "albedo_ok": {
          "type": "boolean",
          "description": "False when a leftover loaded tile has missing/1x1 albedo or no mesh while GPU tex is set (bald leftover)."
        }
      }
    },
    "heightfield": {
      "type": "object",
      "properties": {
        "fn": {
          "type": ["string", "null"],
          "description": "Named demo height_fn: island_height / overworld_height / open_world_height. Live Python fn cannot dump."
        },
        "tile": { "type": ["number", "null"] },
        "stream_radius": { "type": ["number", "null"] },
        "cells": { "type": ["integer", "null"] },
        "lod_radius": { "type": ["number", "null"] },
        "lod_cells": { "type": ["integer", "null"] },
        "uv": {
          "type": "object",
          "properties": {
            "half": { "type": ["number", "null"] },
            "period": { "type": ["number", "null"] },
            "blend": { "type": "number" },
            "pad": { "type": "number" },
            "rect": {
              "oneOf": [
                { "type": "null" },
                {
                  "type": "array",
                  "minItems": 4,
                  "maxItems": 4,
                  "items": { "type": "number" }
                }
              ]
            }
          }
        },
        "tiles": {
          "type": "array",
          "items": { "$ref": "#/$defs/terrain_tile" }
        },
        "samples": {
          "type": "array",
          "items": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": { "type": "number" },
            "description": "[x, z, y]"
          }
        }
      }
    }
  }
}
