{
  "name": "open_world_smoke",
  "script": "examples/vrm_open_world.py",
  "timeout_sec": 240,
  "env": {
    "KAGRA_SMOKE": "1",
    "KAGRA_SMOKE_FRAMES": "40",
    "KAGRA_SMOKE_OUT": "scratch/open_world_smoke.png",
    "KAGRA_SMOKE_WORLD": "scratch/open_world_world.json"
  },
  "expect_files": ["scratch/open_world_smoke.png"],
  "min_file_bytes": 2000,
  "expect_world": {
    "path": "scratch/open_world_world.json",
    "player.on_ground": true,
    "query": [
      {"type": "walker", "name": "player", "count": 1},
      {"type": "prop", "name": "coin", "min_count": 1},
      {"type": "terrain_tile", "min_count": 1, "loaded": true}
    ]
  }
}
