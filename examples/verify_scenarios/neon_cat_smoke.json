{
  "name": "neon_cat_smoke",
  "notes": "Neon Cat runner. Scripted steer and jump. Cat, gates, rings, and obstacles are glTF. The tunnel grid stays emissive scenery. WorldPlay has no neon_cat genre.",
  "script": "examples/neon_cat_minimal.py",
  "env": {"KAGRA_NEON_CAT_HEADLESS": "1"},
  "timeout_sec": 180,
  "expect_files": ["scratch/neon_cat.png", "scratch/neon_cat_world.json"],
  "min_file_bytes": 200,
  "expect_world": {
    "path": "scratch/neon_cat_world.json",
    "query": [
      {"type": "walker", "name": "cat", "count": 1},
      {"type": "prop", "name": "gate", "min_count": 1},
      {"type": "prop", "name": "ring", "min_count": 1},
      {"type": "prop", "name": "obstacle", "min_count": 1}
    ]
  },
  "expect_offscreen": {
    "world": "scratch/neon_cat_world.json",
    "out": "scratch/neon_cat_shared.png",
    "width": 320,
    "height": 180,
    "min_bytes": 200,
    "pixels": [
      {"x": 40, "y": 40, "w": 240, "h": 100, "not_solid": true, "mean_min": [8, 2, 16]}
    ]
  }
}
